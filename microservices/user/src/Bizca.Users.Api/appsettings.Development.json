{
	"ConnectionStrings": {
		"Database": "Server=localhost,1433;Database=bizca-user;User Id=SA;Password=Password0@;TrustServerCertificate=True;"
	},
	"Serilog": {
		"Using": [
			"Serilog.Sinks.Console",
			"Serilog.Sinks.Seq"
		],
		"MinimumLevel": {
			"Default": "Information",
			"Override": {
				"Microsoft": "Information"
			}
		},
		"WriteTo": [
			{ "Name": "Console" },
			{
				"Name": "Seq",
				"Args": { "ServerUrl": "http://seq:5341" }
			}
		],
		"Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
	}
}