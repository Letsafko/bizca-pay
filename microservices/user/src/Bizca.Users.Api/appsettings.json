{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseOptions": {
    "MaxRetryCount": 5,
    "CommandTimeOut": 30,
    "EnableSensitiveDataLogging": true,
    "EnableDetailedErrors": true
  },
  "OpenApiOptions": {
    "Title": "Bizca Users API",
    "Description": "API for managing users in the Bizca platform.",
    "Versions": [ "v1" ],
    "EnableBearerSecurity": true,
    "BearerSchemeName": "Bearer",
    "BearerFormat": "JWT"
  }
}
