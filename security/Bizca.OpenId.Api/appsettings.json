{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "KeycloakOptions": {
    "Authority": "https://keycloak.example.com/realms/bizca",
    "ClientId": "bizca-backend",
    "ClientSecret": "client-secret",
    "Realm": "bizca",
    "Scopes": "openid profile email",
    "JwksCacheDurationSeconds": 3600,
    "HttpTimeoutSeconds": 30
  },
  "OpenApiOptions": {
    "Title": "Bizca OpenID API",
    "Description": "Authentication and token management API for Bizca platform, interfacing with Keycloak.",
    "Versions": [ "v1" ],
    "EnableBearerSecurity": false,
    "BearerSchemeName": "Bearer",
    "BearerFormat": "JWT"
  }
}


